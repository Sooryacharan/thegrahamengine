# Copy this file to .env and fill in what you have.
# SCAN works with none of these set. TRIAGE, BUILD, and PUBLISH need
# GEMINI_API_KEY and will clearly say so and skip cleanly if it's absent.

# Free key from https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY=

# gemini-flash-lite-latest has by far the most generous free-tier daily
# quota of the Gemini model family. Override if you want a heavier model
# (they carry much stricter free-tier limits — e.g. 20 requests/day).
# See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-lite-latest

# Path to the SQLite database file. Created on first run if missing.
DB_PATH=./data/engine.db

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
